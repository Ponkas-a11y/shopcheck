# Pflicht: zufälliger Schlüssel für Sessions  ->  openssl rand -hex 32
SECRET_KEY=
# Der ERSTE registrierte Account wird Admin. Alle weiteren brauchen diesen Code.
# Leer = nach dem ersten Account ist die Registrierung geschlossen.
REGISTRATION_CODE=
# Max. Prüfungen pro Nutzer und Stunde
RATE_LIMIT_PER_HOUR=20
# 1 setzen, wenn die Seite per HTTPS (Reverse Proxy) ausgeliefert wird
COOKIE_SECURE=0
# Optional: Google Safe Browsing API-Key (kostenlos) für Malware-/Phishing-Abgleich
GSB_API_KEY=
